# ─────────────────────────────────────────────────────────────────────────────
# FINAI Backend — Variabili d'ambiente
# Copia in: backend/.env (non committare mai il file .env)
# ─────────────────────────────────────────────────────────────────────────────

# ── Anthropic (obbligatoria) ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Database PostgreSQL ───────────────────────────────────────────────────────
# Formato: jdbc:postgresql://<host>:<port>/<database>
DB_URL=jdbc:postgresql://localhost:5432/finai
DB_USER=finai
DB_PASSWORD=finai

# ── Modello AI ────────────────────────────────────────────────────────────────
# Modelli disponibili: claude-haiku-4-5-20251001, claude-sonnet-4-6, claude-opus-4-7
AI_MODEL=claude-haiku-4-5-20251001
