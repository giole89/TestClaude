# ─────────────────────────────────────────────────────────────────────────────
# FINAI — Variabili d'ambiente per Docker Compose
# Copia questo file in .env e compila i valori
# MAI committare il file .env su git
# ─────────────────────────────────────────────────────────────────────────────

# Chiave API Anthropic (obbligatoria per la chat AI)
# Ottieni la tua su: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...

# Modello AI (opzionale — default: claude-haiku-4-5-20251001)
# Opzioni: claude-haiku-4-5-20251001 | claude-sonnet-4-6 | claude-opus-4-7
AI_MODEL=claude-haiku-4-5-20251001

# ── Database (cambia in produzione) ──────────────────────────────────────────
DB_PASSWORD=finai

# ── PgAdmin (opzionale, usato solo con --profile dev-tools) ──────────────────
PGADMIN_EMAIL=admin@finai.local
PGADMIN_PASSWORD=admin

# ── Swagger UI (abilitare solo in sviluppo locale) ────────────────────────────
# SWAGGER_ENABLED=true
